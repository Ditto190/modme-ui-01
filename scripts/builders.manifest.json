{
  "version": 1,
  "description": "ModMe builder orchestration — SWC transpile, Vite dev/build, Dolt catalog CMS (optional)",
  "builders": [
    {
      "id": "swc",
      "name": "SWC (Speedy Web Compiler)",
      "docs": "https://swc.rs/#download-prebuilt-binaries",
      "rootDevDeps": ["@swc/cli", "@swc/core"],
      "config": "config/builders/swc.swcrc",
      "verify": {
        "cmd": "npx",
        "args": ["swc", "--version"]
      },
      "build": {
        "steps": [
          {
            "id": "transpile-orchestrator-smoke",
            "cwd": ".",
            "cmd": "npx",
            "args": [
              "swc",
              "scripts/builders-orchestrator.mjs",
              "-o",
              ".cache/builders/swc-smoke.mjs",
              "--config-file",
              "config/builders/swc.swcrc"
            ]
          }
        ]
      }
    },
    {
      "id": "vite",
      "name": "Vite",
      "docs": "https://github.com/vitejs/vite",
      "targets": [
        {
          "id": "vibe-web-app",
          "label": "Vibe Web App",
          "cwd": "GenerativeUI_monorepo/apps/vibe-web-app",
          "devScript": "dev",
          "buildScript": "build",
          "portEnv": "VIBE_WEB_PORT",
          "defaultPort": 3000
        },
        {
          "id": "web-dashboard",
          "label": "Web Dashboard (Next — use yarn dev in package)",
          "cwd": "GenerativeUI_monorepo/apps/web-dashboard",
          "devScript": "dev",
          "buildScript": "build",
          "portEnv": "WEB_DASHBOARD_PORT",
          "defaultPort": 3001,
          "note": "Next.js app — Vite verify only when package has vite"
        }
      ],
      "verify": {
        "cwd": "GenerativeUI_monorepo/apps/vibe-web-app",
        "cmd": "npx",
        "args": ["vite", "--version"]
      },
      "build": {
        "steps": [
          {
            "id": "vibe-web-app-build",
            "target": "vibe-web-app",
            "script": "build"
          }
        ]
      }
    },
    {
      "id": "dolt",
      "name": "Dolt (Git for Data)",
      "docs": "https://github.com/dolthub/dolt",
      "optional": true,
      "installHint": "https://github.com/dolthub/dolt#installation — winget install DoltHub.Dolt",
      "verify": {
        "cmd": "dolt",
        "args": ["version"]
      },
      "catalog": {
        "path": "config/dolt/catalog",
        "schema": "config/dolt/catalog/schema.sql",
        "adr": "docs/architecture/decisions/0010-dolt-catalog-cms-evaluation.md"
      }
    }
  ],
  "pipelines": {
    "copilot-session-create": ["swc:ensure", "vite:verify", "dolt:verify"],
    "preflight-builders": ["swc:verify", "swc:build", "vite:verify"],
    "catalog-cms-eval": ["dolt:verify", "dolt:catalog-status"]
  }
}
