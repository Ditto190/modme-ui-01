{
  "version": 1,
  "description": "ModMe quality routing manifest (preflight/CI failures → next steps).",
  "inputs": {
    "reportJsonPath": "docs/devops/reports/preflight-latest.json"
  },
  "routing": {
    "unit-test": {
      "cursor": [
        "Run: yarn test:orchestration",
        "If failing: yarn test:scripts:node",
        "Then re-run: yarn preflight:fast --report"
      ]
    },
    "lint": {
      "cursor": [
        "Run: yarn fix:forge",
        "Then verify: yarn verify:forge",
        "Then re-run: yarn preflight:fast --report"
      ]
    },
    "build": {
      "cursor": [
        "Investigate failing build in CI logs",
        "Run: yarn verify:forge",
        "Then re-run: yarn preflight:fast --report"
      ]
    },
    "env": {
      "cursor": [
        "Run: yarn setup:modme",
        "Then verify: yarn verify:forge",
        "Then re-run: yarn preflight:fast --report"
      ]
    },
    "guard": {
      "cursor": [
        "Run: yarn worktree:doctor",
        "Then re-run: yarn preflight:fast --report"
      ]
    },
    "green pass": {
      "cursor": ["CI green — consider optional bugbot review for large diffs."]
    }
  }
}

