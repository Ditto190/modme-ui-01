{
  "profiles": {
    "worktree-shared-deps": {
      "description": "Worktree junction contract + orchestration smoke",
      "steps": [
        {
          "id": "worktree-link-deps-tests",
          "cmd": "npx",
          "args": [
            "vitest",
            "run",
            "--config",
            "vitest.config.mjs",
            "--project",
            "orchestration",
            "scripts/__tests__/worktree-link-deps.test.mjs"
          ]
        },
        {
          "id": "worktree-smoke",
          "cmd": "node",
          "args": ["e2e/worktree-smoke/run.mjs"]
        }
      ]
    },
    "copilot-workspace": {
      "description": "GitHub Copilot App workspace config + script contract",
      "steps": [
