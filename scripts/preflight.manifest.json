          "args": [
            "vitest",
            "run",
            "--config",
            "vitest.config.mjs",
            "--project",
            "orchestration",
            "scripts/__tests__/copilot-workspace-config.test.mjs"
          ]
        },
        {
          "id": "generate-env-mjs",
          "cmd": "node",
          "args": ["scripts/copilot-workspace/generate-env.mjs"]
        }
      ]
    },
    "env": {
      "description": "Session + forge env verify (Copilot workspace smoke)",
      "steps": [
        {
