{
  "$schema": "./coverage-map.schema.json",
  "version": 1,
  "description": "Pattern → repo paths → verify commands → speckit checklist domain",
  "patterns": {
    "federated-dual-stack": {
      "specSections": ["Boundaries", "Constraints"],
      "paths": [
        "scripts/lib/stack-paths.json",
        ".cursor/rules/monorepo-boundaries.mdc"
      ],
      "verify": ["yarn lint:harness"],
      "checklistDomain": "monorepo-boundaries"
    },
    "path-filtered-ci": {
      "specSections": ["Commands", "Testing Strategy"],
      "paths": [
        "scripts/lib/run-verify-stack.mjs",
        ".githooks/pre-push"
      ],
      "verify": ["yarn pre-commit:check"],
      "checklistDomain": "ci-architecture"
    },
    "contract-first-integration": {
      "specSections": ["Integration", "Success Criteria"],
      "paths": [
        "next-forge/packages/schemas",
        "packages/intake-contracts"
      ],
      "verify": ["yarn molecule-index:verify"],
      "checklistDomain": "contracts"
    },
    "bounded-parallel-agents": {
      "specSections": ["Workflow Preferences", "Success Criteria"],
      "paths": [
        "docs/workflows/thermo-nuclear-dual-monorepo-review.md",
        "next-forge/docs/adr/0012-bounded-parallel-agent-lifecycle.md"
      ],
      "verify": ["yarn lint:harness"],
      "checklistDomain": "ci-architecture"
    },
    "ecl-structured-change": {
      "specSections": ["Boundaries", "Commands"],
      "paths": [
        "harness",
        "docs/ECL.md"
      ],
      "verify": ["yarn lint:harness"],
      "checklistDomain": "monorepo-boundaries"
    },
    "uw-flow-behavior-sync": {
      "specSections": ["Boundaries", "Commands"],
      "paths": [
        "GenerativeUI_monorepo/UniversalWorkbench/.flow/behavior-sync.ts",
        "GenerativeUI_monorepo/UniversalWorkbench/.flow/behavior-validate.ts",
        "GenerativeUI_monorepo/UniversalWorkbench/.flow/behavior-search.ts"
      ],
      "variants": [
        "GenerativeUI_monorepo/UniversalWorkbench-dev/dev/.flow/behavior-sync.ts",
        "GenerativeUI_monorepo/UniversalWorkbench-staging/.flow/behavior-sync.ts"
      ],
      "verify": ["yarn pattern:uw"],
      "checklistDomain": "uw-archive"
    },
    "uw-flow-taxonomy": {
      "specSections": ["Boundaries"],
      "paths": [
        "GenerativeUI_monorepo/UniversalWorkbench/.flow/taxonomy.yaml",
        "GenerativeUI_monorepo/UniversalWorkbench/.flow/README.md"
      ],
      "variants": [
        "GenerativeUI_monorepo/UniversalWorkbench-dev/dev/.flow/taxonomy.yaml",
        "GenerativeUI_monorepo/UniversalWorkbench-staging/.flow/taxonomy.yaml"
      ],
      "verify": ["yarn pattern:uw"],
      "checklistDomain": "uw-archive"
    },
    "uw-agent-inbox-pipeline-tools": {
      "specSections": ["Integration", "Commands"],
      "paths": [
        "GenerativeUI_monorepo/UniversalWorkbench/apps/agent/src/tools/inboxIngest.ts",
        "GenerativeUI_monorepo/UniversalWorkbench/apps/agent/src/tools/mdaCategorize.ts",
        "GenerativeUI_monorepo/UniversalWorkbench/apps/agent/src/workflows/inboxPipeline.ts"
      ],
      "verify": ["yarn pattern:uw"],
      "checklistDomain": "uw-archive"
    },
    "uw-generate-schemas-py": {
      "specSections": ["Commands"],
      "paths": [
        "GenerativeUI_monorepo/UniversalWorkbench/generate_schemas.py"
      ],
      "verify": ["yarn pattern:uw"],
      "checklistDomain": "uw-archive"
    },
    "uw-worktree-scripts": {
      "specSections": ["Commands", "Workflow Preferences"],
      "paths": [
        "GenerativeUI_monorepo/UniversalWorkbench/scripts/init-worktrees.ps1",
        "GenerativeUI_monorepo/UniversalWorkbench/scripts/new-feature.ps1"
      ],
      "verify": ["yarn pattern:uw"],
      "checklistDomain": "uw-archive"
    },
    "uw-validation-patterns-doc": {
      "specSections": ["Testing Strategy"],
      "paths": [
        "GenerativeUI_monorepo/UniversalWorkbench/docs/validation-patterns.md",
        "GenerativeUI_monorepo/UniversalWorkbench/docs/FEATURE-TAXONOMY.md"
      ],
      "verify": ["yarn pattern:uw"],
      "checklistDomain": "uw-archive"
    }
  }
}
