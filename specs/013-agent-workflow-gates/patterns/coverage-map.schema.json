{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coverage-map.schema.json",
  "title": "Pattern coverage map",
  "type": "object",
  "required": ["version", "patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "number" },
    "description": { "type": "string" },
    "patterns": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["paths", "verify", "checklistDomain"],
        "properties": {
          "specSections": {
            "type": "array",
            "items": { "type": "string" }
          },
          "paths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "verify": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "checklistDomain": { "type": "string" },
          "variants": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
