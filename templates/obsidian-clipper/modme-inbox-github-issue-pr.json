{
	"schemaVersion": "0.1.0",
	"name": "ModMe Inbox — GitHub Issue / PR",
	"behavior": "create",
	"description": "Clip a GitHub issue or pull request into an inbox research note (inbox-contract.v1).",
	"noteNameFormat": "{{time|date:\"YYYY-MM-DDTHH-mm-ss\"}}_research_researcher_{{title|safe_name}}",
	"path": "inbox",
	"triggers": [
		"/^https:\\/\\/github\\.com\\/.+\\/(issues|pull)\\/\\d+/"
	],
	"properties": [
		{
			"name": "timestamp",
			"value": "{{time|date:\"YYYY-MM-DDTHH:mm:ssZ\"}}",
			"type": "datetime"
		},
		{
			"name": "uid",
			"value": "{{time|date:\"YYYYMMDDHHmm\"}}",
			"type": "text"
		},
		{
			"name": "agent",
			"value": "human",
			"type": "text"
		},
		{
			"name": "agent_role",
			"value": "researcher",
			"type": "text"
		},
		{
			"name": "type",
			"value": "research",
			"type": "text"
		},
		{
			"name": "severity",
			"value": "medium",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clipper, github, issue-pr",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "summary",
			"value": "{{description ?? meta:og:description}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		}
	],
	"noteContentFormat": "# {{title}}\n\n**URL:** {{url}}\n\n## Summary\n\n{{description ?? meta:og:description}}\n\n{% if selection %}## Selection\n\n{{selection}}\n\n{% endif %}## Body\n\n{{selectorHtml:.js-comment-body|first|markdown ?? selectorHtml:.markdown-body|first|markdown ?? content}}\n"
}
