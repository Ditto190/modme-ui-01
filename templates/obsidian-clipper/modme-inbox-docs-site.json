{
	"schemaVersion": "0.1.0",
	"name": "ModMe Inbox — Docs Site",
	"behavior": "create",
	"description": "Clip documentation pages (Expo, Mintlify, ReadTheDocs, GitBook, etc.) into inbox research notes.",
	"noteNameFormat": "{{time|date:\"YYYY-MM-DDTHH-mm-ss\"}}_research_researcher_{{title|safe_name}}",
	"path": "inbox/web-clipper/{{domain|safe_name}}",
	"triggers": [
		"schema:@TechArticle",
		"/^https:\\/\\/docs\\./",
		"/^https:\\/\\/[^\\/]+\\.readthedocs\\.io\\//",
		"/^https:\\/\\/[^\\/]+\\.gitbook\\.io\\//",
		"/mintlify/",
		"https://docs.expo.dev/"
	],
	"properties": [
		{
			"name": "timestamp",
			"value": "{{time|date:\"YYYY-MM-DDTHH:mm:ssZ\"}}",
			"type": "datetime"
		},
		{
			"name": "uid",
			"value": "{{time|date:\"YYYYMMDDHHmm\"}}",
			"type": "text"
		},
		{
			"name": "agent",
			"value": "human",
			"type": "text"
		},
		{
			"name": "agent_role",
			"value": "researcher",
			"type": "text"
		},
		{
			"name": "type",
			"value": "research",
			"type": "text"
		},
		{
			"name": "severity",
			"value": "medium",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clipper, docs, {{domain}}",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{schema:@TechArticle:headline ?? title}}",
			"type": "text"
		},
		{
			"name": "summary",
			"value": "{{schema:@TechArticle:description ?? description ?? meta:og:description}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "site",
			"value": "{{site ?? domain}}",
			"type": "text"
		}
	],
	"noteContentFormat": "# {{schema:@TechArticle:headline ?? title}}\n\n**URL:** {{url}}\n**Site:** {{site ?? domain}}\n\n## Summary\n\n{{schema:@TechArticle:description ?? description ?? meta:og:description}}\n\n{% if selection %}## Selection\n\n{{selection}}\n\n{% endif %}## Content\n\n{{content}}\n"
}
