{
	"schemaVersion": "0.1.0",
	"name": "ModMe — Dolt catalog CMS",
	"behavior": "create",
	"description": "Clip Dolt catalog CMS use-case articles for inbox/knowledge promotion patterns.",
	"noteNameFormat": "{{time|date:\"YYYY-MM-DDTHH-mm-ss\"}}_research_researcher_{{title|safe_name}}",
	"path": "GenerativeUI_monorepo/docs/inbox",
	"triggers": [
		"/^https:\\/\\/www\\.dolthub\\.com\\/blog\\//",
		"schema:@Article"
	],
	"properties": [
		{
			"name": "timestamp",
			"value": "{{time|date:\"YYYY-MM-DDTHH:mm:ssZ\"}}",
			"type": "datetime"
		},
		{
			"name": "agent",
			"value": "cursor",
			"type": "text"
		},
		{
			"name": "agent_role",
			"value": "researcher",
			"type": "text"
		},
		{
			"name": "type",
			"value": "research",
			"type": "text"
		},
		{
			"name": "severity",
			"value": "medium",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clipper, dolt, cms, catalog",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "summary",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "branch",
			"value": "dev",
			"type": "text"
		}
	],
	"noteContentFormat": "# {{title}}\n\nRelates to ADR-0010 (deferred). Compare git+Supabase promotion vs SQL branch preview.\n\n**URL:** {{url}}\n\n{% if selection %}## Selection\n\n{{selection}}\n\n{% endif %}{{content}}\n"
}
