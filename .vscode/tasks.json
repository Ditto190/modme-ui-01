{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "modme: env bootstrap",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/modme-session.ps1",
        "-Phase",
        "pre-launch"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "modme: KM data plane up",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/km-session-bootstrap.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "modme: KM data plane up (strict)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/km-session-bootstrap.ps1",
        "-Strict"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "modme: KM status",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/km-status.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "modme: agent session start",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/agent-session-start.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "modme: beads ready",
      "type": "shell",
      "command": "npx",
      "args": ["--yes", "@beads/bd", "ready"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "modme: session verify",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/modme-session.ps1",
        "-Phase",
        "verify"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "vibe-web-app: dev",
      "dependsOn": ["modme: env bootstrap"],
      "type": "shell",
      "command": "yarn dev",
      "options": {
        "cwd": "${workspaceFolder}/GenerativeUI_monorepo/apps/vibe-web-app",
        "envFile": "${workspaceFolder}/.vscode/.env.runtime"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:\\s+http://localhost:3000|ready in \\d+)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "agent-generator: build",
      "dependsOn": ["modme: env bootstrap"],
      "type": "shell",
      "command": "yarn build",
      "options": {
        "cwd": "${workspaceFolder}/GenerativeUI_monorepo/apps/agent-generator",
        "envFile": "${workspaceFolder}/.vscode/.env.runtime"
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "next-forge: dev core",
      "dependsOn": ["modme: env bootstrap", "modme: KM data plane up"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "yarn dev:forge:core",
      "options": {
        "cwd": "${workspaceFolder}",
        "envFile": "${workspaceFolder}/.vscode/.env.runtime"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready|started server|Local:)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "agenttrace: overview",
      "dependsOn": ["modme: env bootstrap"],
      "type": "shell",
      "command": "yarn agenttrace --overview",
      "options": {
        "envFile": "${workspaceFolder}/.vscode/.env.runtime"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "modme: agent tui",
      "dependsOn": ["modme: KM data plane up"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "yarn agent:mprocs:generate && yarn agent:tui",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
