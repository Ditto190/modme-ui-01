# https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[*.py]
indent_size = 4

[*.{ps1,psm1}]
indent_size = 4

[*.sh]
end_of_line = lf

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.nix]
indent_size = 2

[flake.nix]
indent_size = 2

[*.bats]
indent_size = 2
