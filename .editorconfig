# Root editorconfig — covers file types without per-monorepo rules.
# GenerativeUI_monorepo/ and agent-library/ keep their own .editorconfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,mts,js,mjs,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
